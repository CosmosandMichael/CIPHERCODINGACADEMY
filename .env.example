# Copy this file to .env and change every secret before deployment.
PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
APP_BASE_URL=http://localhost:3000
DATABASE_FILE=./data/cipher-academy.sqlite

# First-run administrator. Created only when no administrator exists.
ADMIN_NAME=Academy Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisAdminPassword123!

# Optional email delivery. Without SMTP, verification codes are printed in the server terminal (development only).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CIPHER Code Academy <no-reply@example.com>"

# Optional AI tutor. Keep this key on the server; never put it in frontend files.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional Zoom Server-to-Server OAuth. Configure before enabling meeting creation.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
